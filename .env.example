# oceano-admin runtime environment. Every variable is read on the server at request time (ev.env.get);
# none is inlined into the browser bundle. `pnpm dev` reads `.env` plus the shell; production reads the
# container env. Setup of the Entra values: docs/setup/entra.md.

# The public origin the browser uses (no trailing slash). Builds the Entra redirect URIs
# (<origin>/auth/callback, <origin>/auth/signed-out) and makes cookies Secure on https.
# Empty → the request's own origin (fine for local dev at http://localhost:5173).
PUBLIC_ORIGIN=https://admin.oceanorentals.net

# "Oceano Admin" app registration in the gooceano.com tenant. If ANY of the five below is missing (or the
# session secret is shorter than 32 characters) the app shows "Staff sign-in is not configured" and lets
# nobody in.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Secret.
ENTRA_CLIENT_SECRET=
# api://<client-id>/access_as_user
ENTRA_API_SCOPE=
# Secret. 32+ random bytes, e.g. `openssl rand -base64 32`. Keys the encrypted session cookie (HKDF →
# A256GCM). Rotating it signs everyone out.
ADMIN_SESSION_SECRET=

# oceano-core base URL (no global prefix): /admin/me, /admin/site-tokens, /admin/staff…, plus the legacy
# modules (IoT, leads, infrastructure, backups). Also the dev server's /socket.io proxy target.
CORE_API_URL=https://services.oceanorentals.net

# RockyPoint.net API, including /api/v1 (staging shown). Called with oceano-core site tokens.
RPN_API_URL=https://api-staging.rockypoint.net/api/v1

# `pnpm serve` only: port of the node server (nginx proxies to 3000 in the Docker image).
# PORT=3000
